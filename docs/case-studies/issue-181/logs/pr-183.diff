+  it('refreshes cached YouTube playlists from the API on app startup', () => {
+    const futureExpiry = Date.now() + 3600 * 1000;
+
+    cy.intercept('GET', 'https://www.googleapis.com/youtube/v3/playlists*', {
+      statusCode: 200,
+      body: {
+        items: [
+          {
